#!/usr/bin/env bash

SOURCE="${BASH_SOURCE[0]}"
while [[ -h "$SOURCE" ]]; do
    SOURCE_DIR="$(CDPATH= cd -- "$(dirname -- "$SOURCE")" && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ "$SOURCE" = /* ]] || SOURCE="$SOURCE_DIR/$SOURCE"
done
SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$SOURCE")" && pwd)"
exec "$SCRIPT_DIR/ubuntu-mode-switcher.sh" "$@"
